SX_ENV=development
DATABASE_URL=./sx_license.db
PORT=8000

# This value is embedded in the Android client. It authenticates activation
# requests but is never used to sign license tokens.
CLIENT_SIGN_SECRET=CHANGE_ME_CLIENT_SIGN_SECRET

# PKCS#8 RSA private key. Keep it server-side. For dotenv files, encode line
# breaks as \n, for example:
# TOKEN_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
TOKEN_PRIVATE_KEY_PEM=CHANGE_ME_RSA_PRIVATE_KEY_PEM

CARDNET_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET
ADMIN_API_KEY=CHANGE_ME_ADMIN_API_KEY

# Enable temporarily only while migrating pre-RSA tokens.
ALLOW_LEGACY_TOKEN_MIGRATION=false
LEGACY_TOKEN_SECRET=CHANGE_ME_LEGACY_TOKEN_SECRET
