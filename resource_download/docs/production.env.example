# ==============================================================================
# 生产环境配置模板 (Production Environment Configuration Template)
# 注意：在生产环境部署时，必须覆盖 API_KEY 与 JWT_SECRET 为强随机密钥！
# ==============================================================================

# 服务监听配置
# 注意：若 HOST 设为 0.0.0.0 或公网 IP，API_KEY 禁止使用默认 'dev-key-change-me' (E3 启动门闸阻断)
HOST=0.0.0.0
PORT=8000
API_KEY=PROD_STRONG_API_KEY_CHANGE_THIS_RANDOM_SECRET_987654321

# 商业多租户鉴权配置
# AUTH_MODE 建议设为 dual (同时支持用户 Token 与运维 Key) 或 jwt_only (仅用户 Token)
# 当 AUTH_MODE=dual/jwt_only 时，JWT_SECRET 禁止使用默认 'change-me-jwt-secret' (E3 启动门闸阻断)
AUTH_MODE=dual
JWT_SECRET=PROD_STRONG_JWT_SECRET_KEY_CHANGE_THIS_MUST_BE_AT_LEAST_32_BYTES!
JWT_EXPIRE_MINUTES=10080

# 频率限制与 VIP 每日配额
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10
FREE_JOBS_PER_DAY=0
VIP_JOBS_PER_DAY=50

# License Service（生产必须配置；私钥不得提交 Git 或返回客户端）
LICENSE_SERVICE_BASE_URL=https://license.example.internal
LICENSE_SERVICE_KEY_ID=<RD service_key_id>
LICENSE_SERVICE_PRIVATE_KEY=<RD service_private_key>
LICENSE_SERVICE_AUDIENCE=rd
LICENSE_CACHE_TTL_SECONDS=30
LICENSE_SERVICE_TIMEOUT=3.0
LICENSE_SERVICE_VERIFY=true
# LICENSE_SERVICE_CA_BUNDLE=/etc/rd/license-ca.pem
# LICENSE_SERVICE_CLIENT_CERT=/etc/rd/license-client.crt
# LICENSE_SERVICE_CLIENT_KEY=/etc/rd/license-client.key

# Windows 客户端发布清单（未配置 URL 时更新检查保持关闭）
CLIENT_LATEST_VERSION=1.0.0
CLIENT_MINIMUM_VERSION=1.0.0
# CLIENT_UPDATE_URL=https://download.example.com/ResourceDownloader-1.0.0-Setup.exe
# CLIENT_UPDATE_SHA256=<64位小写SHA-256>
CLIENT_RELEASE_NOTES=首个正式版本
CLIENT_UPDATE_MANDATORY=false
CLIENT_UPDATE_ROLLOUT_PERCENTAGE=100

# 签名池配置
SIGN_POOL_ENABLED=false
SIGN_POOL_CONFIG=data/sign_pool.json
# SIGN_POOL_URLS=http://127.0.0.1:19101,http://127.0.0.1:19102
SIGN_POOL_HEALTH_INTERVAL_SEC=30
SIGN_POOL_LEASE_SEC=120
SIGN_POOL_MAX_FAILS=3

# MuMu runtime target (identity is the instance name; endpoint is discovered)
ADB_PATH=adb
ADB_DEVICE=
MUMU_INSTANCE_NAME=RD测试
# MUMU_MANAGER_PATH=C:\\Program Files\\Netease\\MuMu Player 12\\shell\\MuMuManager.exe
FRIDA_HOST=127.0.0.1:27042
FANQIE_PKG=com.dragon.read
HONGGUO_PKG=com.phoenix.read
