# 服务监听（本应用仅支持单进程 WORKERS=1，禁止配置 WORKERS>1）
API_KEY=dev-key-change-me
HOST=127.0.0.1
PORT=8000

# 客户端更新发布清单（本地开发默认关闭）
CLIENT_LATEST_VERSION=1.0.0
# CLIENT_UPDATE_URL=https://download.example.com/ResourceDownloader-1.0.0-Setup.exe
# CLIENT_UPDATE_SHA256=
CLIENT_UPDATE_ROLLOUT_PERCENTAGE=100
WORKERS=1


# 鉴权模式（阶段 D-0）
#   dev      — 仅 X-API-Key（默认；脚本 e2e / 本机桌面零改）
#   dual     — X-API-Key 或 Authorization: Bearer <jwt>
#   jwt_only — 仅 Bearer JWT
# JWT 校验在 D-1 实现；D-0 下 dual/jwt_only 携带 Bearer 时返回 501
AUTH_MODE=dual
JWT_SECRET=replace-with-a-random-32-byte-secret
JWT_EXPIRE_MINUTES=10080

# 限流与每日配额（阶段 D-4）
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10
FREE_JOBS_PER_DAY=0
VIP_JOBS_PER_DAY=50
MAX_CONCURRENT_JOBS=5
MAX_QUEUED_JOBS=100

# License Service（RD Service Credential；以下 Secret 仅从部署环境注入）
LICENSE_SERVICE_BASE_URL=https://license.example.internal
LICENSE_SERVICE_KEY_ID=<RD service_key_id>
LICENSE_SERVICE_PRIVATE_KEY=<RD service_private_key; do not commit>
LICENSE_SERVICE_AUDIENCE=rd
LICENSE_CACHE_TTL_SECONDS=30
LICENSE_SERVICE_TIMEOUT=3.0
LICENSE_SERVICE_VERIFY=true
# LICENSE_SERVICE_CA_BUNDLE=<optional CA bundle path>
# LICENSE_SERVICE_CLIENT_CERT=<optional mTLS client cert path>
# LICENSE_SERVICE_CLIENT_KEY=<optional mTLS client key path>


# ADB 与 Frida 配置
# ADB / Frida（番茄/红果 App 签名与下载；必须与 adb devices 一致）
ADB_PATH=adb
# Optional assertion only. Leave empty to discover the exact MuMu instance by name.
ADB_DEVICE=
MUMU_INSTANCE_NAME=RD测试
# MUMU_MANAGER_PATH=...\MuMuManager.exe
FRIDA_HOST=127.0.0.1:27042
FANQIE_PKG=com.dragon.read
HONGGUO_PKG=com.phoenix.read
# 启动探测 + 自启 agent/各平台 App（默认告警不阻断）
PLATFORM_PROBE_ON_STARTUP=true
FANQIE_TRY_START_AGENT=true
TRY_START_PLATFORM_APPS=true
FANQIE_REQUIRE_RUNTIME=false
REQUIRE_PLATFORM_APPS=false

# 签名池配置（阶段 D-3）
SIGN_POOL_ENABLED=false
SIGN_POOL_CONFIG=data/sign_pool.json
# SIGN_POOL_URLS=http://127.0.0.1:19101,http://127.0.0.1:19102
SIGN_POOL_HEALTH_INTERVAL_SEC=30
SIGN_POOL_LEASE_SEC=120
SIGN_POOL_MAX_FAILS=3

