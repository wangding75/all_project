# 服务监听
API_KEY=dev-key-change-me
HOST=127.0.0.1
PORT=8000

# 鉴权模式（阶段 D-0）
#   dev      — 仅 X-API-Key（默认；脚本 e2e / 本机桌面零改）
#   dual     — X-API-Key 或 Authorization: Bearer <jwt>
#   jwt_only — 仅 Bearer JWT
# JWT 校验在 D-1 实现；D-0 下 dual/jwt_only 携带 Bearer 时返回 501
AUTH_MODE=dev
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRE_MINUTES=10080

# 限流与每日配额（阶段 D-4）
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10
FREE_JOBS_PER_DAY=0
VIP_JOBS_PER_DAY=50


# FANQIE_COOKIE=
# FANQIE_DELAY=1.0
# ADB_PATH=
# ADB_DEVICE=127.0.0.1:16384
# FRIDA_HOST=127.0.0.1:27042
